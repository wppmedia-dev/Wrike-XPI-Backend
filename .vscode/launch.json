{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach by Process ID",
      "processId": "${command:PickProcess}",
      "request": "attach",
      "skipFiles": ["<node_internals>/**"],
      "type": "node"
    },
    {
      // Same command as `npm run dev`: Node's built-in watcher restarts on
      // changes under src/ (replaces nodemon), @babel/register compiles on the
      // fly (replaces babel-node). The debugger re-attaches after each restart.
      "type": "node",
      "request": "launch",
      "name": "Launch",
      "skipFiles": ["<node_internals>/**"],
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--watch-path=src",
        "--max-old-space-size=4096",
        "-r",
        "@babel/register"
      ],
      "program": "${workspaceFolder}/src/index.js",
      "sourceMaps": true,
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      // No restart on change — steadier when stepping through code.
      "type": "node",
      "request": "launch",
      "name": "Launch (no watch)",
      "skipFiles": ["<node_internals>/**"],
      "runtimeExecutable": "node",
      "runtimeArgs": ["--max-old-space-size=4096", "-r", "@babel/register"],
      "program": "${workspaceFolder}/src/index.js",
      "sourceMaps": true,
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
