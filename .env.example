# Copy to .env and fill in. Never commit real values.

# Application
NODE_ENV=development
PORT=4000
BASE_PATH=
API_URL=
# Public origin of this service. Also the default CORS origin for the
# admin/portal console APIs (see CORS_ALLOWED_ORIGINS below).
APP_URL=http://localhost:4000

# API Rate Limit
RATE_LIMIT=120
RATE_LIMIT_TIME=1 minute

# MCP Rate Limit
MCP_RATE_LIMIT=60
MCP_RATE_LIMIT_TIME=1 minute

# Security
JWT_SECRET=
SESSION_SECRET=
# 64 hex chars (32 bytes): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=

# Database
DB_HOST=
DB_NAME=
DB_USERNAME=
DB_SECRET=
DB_PORT=5432

# Wrike
WRIKE_ENDPOINT=
WRIKE_LOGIN_ENDPOINT=
WRIKE_REDIRECT_URL=
WRIKE_DATAHUB_RECORDS_LIMIT=

# Wrike's MCP server
WRIKE_MCP_URL=https://mcp.wrike.com/v2

# Wrike DataHub
WRIKE_DATAHUB_ENDPOINT=
DATAHUB_REQUEST_FORM_ID=
DATAHUB_SPACE_ID=
DATAHUB_ENTITY_ID=
DATAHUB_CUSTOM_FIELDS_ID=
DATAHUB_REQUEST_FORM_FIELDS_ID=
DATAHUB_AMOEBA_MODULE_ID=
DATAHUB_AMOEBA_SERVICE_ID=

# Azure Vault
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=
AZURE_VAULT_URL=

# Only for Dev
# NODE_TLS_REJECT_UNAUTHORIZED=0

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DEFAULT_TTL=3600

# Environment API Access Scope
ENV_ACCESS_MEMORY_TTL=30
ENV_ACCESS_RULES_TTL=300
ENV_ACCESS_IDENTITY_TTL=300
TRUST_PROXY=true

# Audit Log
ACTIVITY_LOG_RETENTION_DAYS=30

# Calendar Sync
CALENDAR_SYNC_ENDPOINT=

# ─── Security hardening ────────────────────────────────────────────────────
# Every value below is optional; the commented value is the default.

# CORS for the admin/portal console APIs: extra allowed origins besides
# APP_URL, comma-separated, exact match. Other APIs keep "*".
# CORS_ALLOWED_ORIGINS=https://admin.example.com,https://portal.example.com

# Content-Security-Policy
# CSP_REPORT_ONLY=false
# CSP_EXTRA_SCRIPT_SRC=
# CSP_EXTRA_CONNECT_SRC=

# Session cookie ("auto" = Secure on HTTPS)
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_SAMESITE=lax

# Key rotation (see src/utils/crypto.js, src/utils/jwtSecrets.js)
ENCRYPTION_MASTER_KEY_ID=k1
# Retired master keys, decrypt-only: "keyId:64hex,keyId:64hex"
# ENCRYPTION_MASTER_KEYS_PREVIOUS=
# Retired JWT secrets, verify-only, comma-separated
# JWT_SECRET_PREVIOUS=

# Redis reconnect
# REDIS_RECONNECT_MAX_MS=30000
# REDIS_DOWN_LOG_INTERVAL_MS=300000

# Cross-instance cache invalidation
# CACHE_BUS_CHANNEL=xpi:cache-bus
# CACHE_BUS_DISABLED=false
# Periodic credentials resync, ms (0 disables)
# WRIKE_CREDENTIALS_RESYNC_MS=300000

# Readiness / graceful shutdown
# READY_DB_TIMEOUT_MS=3000
# SHUTDOWN_TIMEOUT_MS=25000

# OAuth dynamic client registration
# OAUTH_CLIENT_TTL_DAYS=365
# OAUTH_REGISTER_RATE_LIMIT=20
# OAUTH_REGISTER_RATE_LIMIT_TIME=1 hour
# OAUTH_ACCEPT_LEGACY_CLIENTS=true
